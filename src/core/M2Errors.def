DEFINITION MODULE M2Errors;

EXPORT QUALIFIED ErrorCode, Success, ErrGeneric, ErrOutOfMemory, ErrInvalidArg, ErrIndexOutOfBounds, ErrNotFound, ErrAlreadyExists, ErrIO, ErrOverflow, ErrUnderflow, ErrDivByZero, ErrDomain, ErrRange, ErrFormat, ErrEOF, ErrPermission, ErrNotSupported, ErrTimeout, ErrBusy, ErrInterrupted, ErrCorrupt, ErrorToString, ReportError, ClearError, LastError,ErrorHandler,SetHandler;

TYPE ErrorCode=(Success,ErrGeneric,ErrOutOfMemory,ErrInvalidArg,ErrIndexOutOfBounds,ErrNotFound,ErrAlreadyExists,ErrIO,ErrOverflow,ErrUnderflow,ErrDivByZero,ErrDomain,ErrRange,ErrFormat,ErrEOF,ErrPermission,ErrNotSupported,ErrTimeout,ErrBusy,ErrInterrupted,ErrCorrupt);

TYPE ErrorHandler = PROCEDURE (ErrorCode; ARRAY OF CHAR);

PROCEDURE ErrorToString(code: ErrorCode;

VAR s: ARRAY OF CHAR);

PROCEDURE ReportError(code: ErrorCode;

msg: ARRAY OF CHAR);

PROCEDURE ClearError;

PROCEDURE LastError(): ErrorCode;

PROCEDURE SetHandler(h: ErrorHandler);

END M2Errors.
