DEFINITION MODULE M2Stack;

EXPORT QUALIFIED Stack,Create,Destroy,Push,Pop,Peek,Size,IsEmpty,Clear;

TYPE Stack=POINTER TO Node;

Node=RECORD value:CARDINAL;

next:Stack END;

PROCEDURE Create():Stack;

PROCEDURE Destroy(VAR s:Stack);

PROCEDURE Push(VAR s:Stack;

v:CARDINAL):BOOLEAN;

PROCEDURE Pop(VAR s:Stack;

VAR v:CARDINAL):BOOLEAN;

PROCEDURE Peek(s:Stack;

VAR v:CARDINAL):BOOLEAN;

PROCEDURE Size(s:Stack):CARDINAL;

PROCEDURE IsEmpty(s:Stack):BOOLEAN;

PROCEDURE Clear(VAR s:Stack);

END M2Stack.
