IMPLEMENTATION MODULE M2Endian;

PROCEDURE Swap16(x:CARDINAL):CARDINAL;

BEGIN RETURN(x MOD 256)*256+x DIV 256 END Swap16;

PROCEDURE Swap32(x:CARDINAL):CARDINAL;

BEGIN RETURN(x MOD 256)*16777216+((x DIV 256)MOD 256)*65536+((x DIV 65536)MOD 256)*256+x DIV 16777216 END Swap32;

PROCEDURE ReadBE16(b0,b1:CARDINAL):CARDINAL;

BEGIN RETURN(b0 MOD 256)*256+(b1 MOD 256)END ReadBE16;

PROCEDURE ReadBE32(b0,b1,b2,b3:CARDINAL):CARDINAL;

BEGIN RETURN(b0 MOD 256)*16777216+(b1 MOD 256)*65536+(b2 MOD 256)*256+(b3 MOD 256)END ReadBE32;

PROCEDURE WriteBE16(x:CARDINAL;

VAR b0,b1:CARDINAL);

BEGIN b0:=x DIV 256;

b1:=x MOD 256 END WriteBE16;

PROCEDURE WriteBE32(x:CARDINAL;

VAR b0,b1,b2,b3:CARDINAL);

BEGIN b0:=x DIV 16777216;

b1:=(x DIV 65536)MOD 256;

b2:=(x DIV 256)MOD 256;

b3:=x MOD 256 END WriteBE32;

END M2Endian.
