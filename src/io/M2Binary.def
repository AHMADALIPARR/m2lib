DEFINITION MODULE M2Binary;

EXPORT QUALIFIED ReadBE32,WriteBE32;

PROCEDURE ReadBE32(b:ARRAY OF CHAR;

pos:CARDINAL;

VAR value:CARDINAL):BOOLEAN;

PROCEDURE WriteBE32(VAR b:ARRAY OF CHAR;

pos,value:CARDINAL):BOOLEAN;

END M2Binary.
