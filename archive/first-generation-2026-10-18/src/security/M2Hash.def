DEFINITION MODULE M2Hash;

EXPORT QUALIFIED FNV1a32, DJB2;

PROCEDURE FNV1a32 (data: ARRAY OF CHAR;
 length: CARDINAL): CARDINAL;

PROCEDURE DJB2 (data: ARRAY OF CHAR;
 length: CARDINAL): CARDINAL;

END M2Hash.
