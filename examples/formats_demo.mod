(* Assistant-added demo. Written, not executed: gm2 was unavailable. *)
MODULE formats_demo;
FROM M2CSV IMPORT CountFields, ParseRow;
FROM M2INI IMPORT FindValue, ParseBoolean, ParseCardinal;
FROM M2JSON IMPORT EscapeString, IsWhitespace;
FROM M2Path IMPORT Join, Basename, Dirname, Extension, IsAbsolute;
FROM M2NetFrame IMPORT Encode, Decode;
FROM M2Strings IMPORT Equal;
VAR fields: ARRAY [0..3] OF ARRAY [0..31] OF CHAR;
    count: CARDINAL; ok: BOOLEAN; b: BOOLEAN;
    buf, out: ARRAY [0..63] OF CHAR;
    frame: ARRAY [0..63] OF CHAR; payload: ARRAY [0..63] OF CHAR;
    frameLen, payloadLen, n: CARDINAL;
BEGIN
  IF CountFields("a,b,c")#3 THEN HALT(1) END;
  IF CountFields('a,"b,c",d')#3 THEN HALT(2) END;
  ok:=ParseRow("a,b,c",fields,count);
  IF NOT ok OR (count#3) THEN HALT(3) END;
  IF NOT Equal(fields[0],"a") THEN HALT(4) END;
  IF NOT Equal(fields[2],"c") THEN HALT(5) END;
  ok:=FindValue("key = value", "key", buf);
  IF NOT ok OR NOT Equal(buf,"value") THEN HALT(6) END;
  ok:=FindValue("other=1", "key", buf);
  IF ok THEN HALT(7) END;
  ok:=ParseBoolean("true",b);
  IF NOT ok OR NOT b THEN HALT(8) END;
  ok:=ParseCardinal("42",n);
  IF NOT ok OR (n#42) THEN HALT(9) END;
  ok:=ParseCardinal("12x",n);
  IF ok THEN HALT(10) END;
  ok:=EscapeString('a"b', out);
  IF NOT ok OR NOT Equal(out,'a\"b') THEN HALT(11) END;
  IF NOT IsWhitespace(' ') THEN HALT(12) END;
  IF IsWhitespace('x') THEN HALT(13) END;
  ok:=Join("src","lib",out);
  IF NOT ok OR NOT Equal(out,"src/lib") THEN HALT(14) END;
  Basename("/a/b/c.mod",out);
  IF NOT Equal(out,"c.mod") THEN HALT(15) END;
  Dirname("/a/b/c.mod",out);
  IF NOT Equal(out,"/a/b") THEN HALT(16) END;
  Extension("/a/b/c.mod",out);
  IF NOT Equal(out,".mod") THEN HALT(17) END;
  IF NOT IsAbsolute("/etc") THEN HALT(18) END;
  IF IsAbsolute("rel/path") THEN HALT(19) END;
  ok:=Encode("hi",frame,frameLen);
  IF NOT ok OR (frameLen#6) THEN HALT(20) END;
  ok:=Decode(frame,frameLen,payload,payloadLen);
  IF NOT ok OR (payloadLen#2) THEN HALT(21) END;
  IF NOT Equal(payload,"hi") THEN HALT(22) END;
  ok:=Decode(frame,5,payload,payloadLen);
  IF ok THEN HALT(23) END;
END formats_demo.
