DEFINITION MODULE M2Hex;

EXPORT QUALIFIED Encode, Decode;

PROCEDURE Encode (src: ARRAY OF CHAR;
 length: CARDINAL;
 VAR dst: ARRAY OF CHAR): BOOLEAN;

PROCEDURE Decode (src: ARRAY OF CHAR;
 VAR dst: ARRAY OF CHAR;
 VAR written: CARDINAL): BOOLEAN;

END M2Hex.
